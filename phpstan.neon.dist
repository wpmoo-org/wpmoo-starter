includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - resources/phpstan/phpstan-baseline.neon

parameters:
    level: 6
    phpVersion: 70400
    paths:
        - src
    excludePaths:
        - vendor
        - tests
    stubFiles:
        - vendor/wpmoo/wpmoo/resources/phpstan/stubs/wpmoo-fields-field.stub.php
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
